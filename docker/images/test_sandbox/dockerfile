FROM python:3.10-slim

ENV HOME=/tmp
ENV ULTRALYTICS_CONFIG_DIR=/tmp/Ultralytics
ENV CUDA_VISIBLE_DEVICES=-1
ENV TF_CPP_MIN_LOG_LEVEL=3
ENV XDG_CONFIG_HOME=/tmp/xdg-config
ENV MPLCONFIGDIR=/tmp/xdg-config/matplotlib
ENV ULTRALYTICS_SETTINGS=0
ENV U2NET_HOME=/app/src/shared_task_data

ENV TMPDIR=/tmp
ENV TEMP=/tmp
ENV TMP=/tmp

ENV TEST_TMPDIR=/tmp/absl_testing

WORKDIR /app

RUN mkdir -p /tmp/Ultralytics && echo "version: 0.0.6" > /tmp/Ultralytics/settings.yaml

RUN mkdir -p /tmp/xdg-config /tmp/xdg-config/matplotlib /tmp/Ultralytics /tmp/absl_testing \
    && chmod 1777 /tmp /tmp/xdg-config /tmp/xdg-config/matplotlib /tmp/Ultralytics /tmp/absl_testing \
    && chown -R root:root /tmp/xdg-config /tmp/xdg-config/matplotlib /tmp/Ultralytics /tmp/absl_testing

RUN pip install tflite-runtime pillow keras cryptography protobuf rembg onnxruntime
RUN pip install numpy==1.24.0
COPY docker/images/test_sandbox/orange.png /app/orange.png
COPY docker/images/test_sandbox/main.py /app/main.py
COPY docker/src/ /app/src/
COPY lib/edge_pb2.py /app/lib/edge_pb2.py
COPY lib/scheduler.py /app/lib/scheduler.py

RUN python -m compileall -q /usr/local/lib/python*/site-packages
# RUN python -c "from rembg import new_session; new_session('u2netp')"

RUN python - <<'PY'
import multiprocessing as mp

def main():
    from rembg import new_session
    new_session('u2netp')

with mp.Pool(1) as pool:
    pool.apply(main)
PY

ENTRYPOINT [ "python3", "-u", "main.py" ]
